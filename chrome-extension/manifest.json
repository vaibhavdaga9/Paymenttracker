{
  "manifest_version": 3,
  "name": "PaymentTracker WhatsApp Helper",
  "version": "1.0.0",
  "description": "Reads WhatsApp mobile numbers and shows outstanding bills from PaymentTracker API.",
  "permissions": ["storage", "tabs", "sidePanel"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://wa.me/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "PaymentTracker"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
